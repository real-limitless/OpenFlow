# OpenFlow toolbox — agentic scripting, git, and catalog RAG reindex.
# Not the API server. Use:
#   docker compose --profile tools up -d toolbox
#   docker compose exec toolbox bash
#   docker compose run --rm toolbox catalog-reindex
#
# Shares /data/workspace with the api service for clone/script workdirs.

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fd-find \
    git \
    jq \
    less \
    make \
    openssh-client \
    openssl \
    postgresql-client \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    rsync \
    unzip \
    wget \
  && ln -sf /usr/bin/python3 /usr/bin/python \
  && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Lightweight helpers for operators (no full app install required for shell work).
COPY scripts/toolbox/ /usr/local/lib/openflow-toolbox/
COPY scripts/toolbox-entrypoint.sh /usr/local/bin/openflow-toolbox
RUN chmod +x /usr/local/bin/openflow-toolbox \
  && ln -sf /usr/local/bin/openflow-toolbox /usr/local/bin/catalog-reindex \
  && ln -sf /usr/local/bin/openflow-toolbox /usr/local/bin/catalog-eval \
  && mkdir -p /data/workspace /data/catalog

ENV NODE_ENV=development \
    OPENFLOW_WORKSPACE_DIR=/data/workspace \
    OPENFLOW_CATALOG_RAG_ENABLED=true \
    PATH="/workspace/node_modules/.bin:${PATH}"

VOLUME ["/data/workspace", "/data/catalog"]

ENTRYPOINT ["/usr/local/bin/openflow-toolbox"]
CMD ["wait"]
