# Optional for Docker try-out (docker compose up -d works with no .env).
# For local Node dev:  cp .env.example .env && npm run setup
#
# Local dev (API on host): DATABASE_URL/REDIS use localhost ports from compose.
# docker compose up: compose overrides DATABASE_URL/REDIS_URL to db/redis service names.

# ─── Core ─────────────────────────────────────────────────

# Database: PostgreSQL (run via `docker compose up -d db`)
DATABASE_URL="postgresql://openflow:openflow@localhost:15432/openflow"

# Disable auth for local development
AUTH_DISABLED="true"

# AES-256-GCM key for encrypting stored credentials (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Docker entrypoint auto-generates and persists one if empty.
CREDENTIALS_KEY=""

# Default secret backend for new credentials: local | vault | aws-sm
# External backends are configured via POST /api/v1/secret-providers
SECRETS_BACKEND="local"

# Redis for BullMQ job queue
REDIS_URL="redis://localhost:6379"

# Directory for binary data storage (when BINARY_STORAGE=fs)
BINARY_STORAGE_DIR="./data/binary"

# Binary backend: fs | s3 (S3-compatible: AWS, MinIO, …)
BINARY_STORAGE="fs"

# ─── Logging ──────────────────────────────────────────────
# LOG_LEVEL=debug|info|warn|error
LOG_LEVEL="info"
# LOG_FORMAT=json|pretty
LOG_FORMAT="json"
# Stream sinks: none | http | datadog
LOG_STREAM_TYPE="none"
# LOG_STREAM_URL="https://logs.example.com/ingest"   # when type=http
# DD_API_KEY=""                                      # when type=datadog
# DD_SITE="datadoghq.com"
# DD_SERVICE="openflow"
# BINARY_S3_BUCKET="openflow"
# BINARY_S3_REGION="us-east-1"
# BINARY_S3_ENDPOINT="http://localhost:9000"   # MinIO / custom
# BINARY_S3_ACCESS_KEY="minioadmin"
# BINARY_S3_SECRET_KEY="minioadmin"
# BINARY_S3_PREFIX="openflow/binary/"
# BINARY_S3_FORCE_PATH_STYLE="true"

# BullMQ worker (runs inside the API process by default)
RUN_WORKER="true"
WORKER_CONCURRENCY="5"

# Dev: enable POST /api/v1/dev/reload-nodes and GET /api/v1/dev/nodes
# (also enabled when AUTH_DISABLED=true or NODE_ENV=development)
OPENFLOW_HOT_NODES="true"

# Frontend storage (Vite). Leave unset to use the API/database (recommended).
# VITE_API_BASE_URL=""          # same-origin /api (default)
# VITE_USE_LOCAL_STORAGE="true" # browser-only (execute/subflows will NOT see these)

# ─── Workflow editor assistant ────────────────────────────
# Right-rail chat that creates/edits/runs nodes via tools (or OpenCode + MCP).
# Docs: docs/assistant.md

# Feature flag (default on). Set "false" to hide/disable.
OPENFLOW_ASSISTANT_ENABLED="true"

# Backend: "builtin" (OpenAI-compatible tool loop) | "opencode"
OPENFLOW_ASSISTANT_BACKEND="builtin"

# Max tool-calling rounds per user message (builtin backend)
OPENFLOW_ASSISTANT_MAX_STEPS="24"

# LLM for builtin backend (OpenAI-compatible Chat Completions API)
# Prefer OPENFLOW_ASSISTANT_* ; OPENAI_* are accepted as fallbacks.
#
# OpenRouter example:
#   OPENFLOW_ASSISTANT_BASE_URL="https://openrouter.ai/api/v1"
#   OPENFLOW_ASSISTANT_API_KEY="sk-or-v1-..."
#   OPENFLOW_ASSISTANT_MODEL="openai/gpt-4o-mini"
#   (or anthropic/claude-sonnet-4, google/gemini-2.5-flash, etc.)
#
# OpenAI example:
#   OPENFLOW_ASSISTANT_BASE_URL="https://api.openai.com/v1"
#   OPENFLOW_ASSISTANT_MODEL="gpt-4o-mini"
OPENFLOW_ASSISTANT_API_KEY=""
OPENFLOW_ASSISTANT_BASE_URL="https://openrouter.ai/api/v1"
OPENFLOW_ASSISTANT_MODEL="openai/gpt-4o-mini"

# Fallbacks if OPENFLOW_ASSISTANT_* are unset
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/gpt-4o-mini"

# ─── Optional: OpenCode backend ───────────────────────────
# Only needed when OPENFLOW_ASSISTANT_BACKEND=opencode
# OPENFLOW_ASSISTANT_BACKEND="opencode"
# OPENCODE_BIN="opencode"
# Point at an already-running server (recommended in Docker):
# OPENCODE_BASE_URL="http://host.docker.internal:4096"
# Or let the API spawn `opencode serve` (needs binary in the image):
# OPENCODE_HOSTNAME="127.0.0.1"
# OPENCODE_PORT="4096"
# OPENCODE_SERVER_PASSWORD=""
# OPENCODE_SERVER_USERNAME="opencode"
# OPENCODE_API_KEY=""

# ─── Remote MCP (third-party chatbots) ───────────────────
# Docs: docs/mcp.md
# Public URL used as OAuth issuer + resource metadata (no trailing slash).
# OPENFLOW_PUBLIC_URL="https://openflow.example.com"
# Feature flag (default on). Independent of assistant LLM.
OPENFLOW_MCP_ENABLED="true"

# When running OpenCode standalone against OpenFlow MCP:
# OPENFLOW_MCP_URL="http://localhost:3000/mcp/openflow"
# OPENFLOW_WORKFLOW_ID="<workflow-id>"

# ─── Template libraries ─────────────────────────────────
# Default source: config/template-sources.json → n8n-workflow-library
# Operator overrides: config/template-sources.local.json (gitignored)
# Or JSON array/object merge:
# OPENFLOW_TEMPLATE_SOURCES='[{"id":"my-team","name":"My Team","url":"https://github.com/org/tpl.git","ref":"main","priority":10}]'
# Legacy single-source overrides for the default n8n-community entry:
# N8N_LIBRARY_REPO="https://github.com/real-limitless/n8n-workflow-library.git"
# N8N_LIBRARY_REF="main"
# N8N_LIBRARY_DIR="../n8n-workflow-library"
#
# ─── Code node (Python) ──────────────────────────────────
# Prefer Settings → Code node in the UI for extra import allowlist (DB).
# Env still works and is merged with UI settings:
# OPENFLOW_PYTHON_ALLOW_IMPORTS="numpy,requests"
# OPENFLOW_PYTHON_BIN="python3"
# OPENFLOW_PYTHON_TIMEOUT_MS="30000"

# ─── Semantic node catalog (RAG) ─────────────────────────
# Docs: docs/catalog-rag.md  ·  toolbox: docs/toolbox.md
# OPENFLOW_CATALOG_RAG_ENABLED="true"
# Prefer domain nodes over shell; shell stays available but rank-penalized.
# OPENFLOW_CATALOG_SHELL_PENALTY="0.35"
# OPENFLOW_CATALOG_USE_PGVECTOR="true"
# Embeddings — OpenAI-compatible POST {base}/embeddings (remote GPU TEI / Ollama / OpenRouter).
# Prefer a dedicated embed URL for speed (do not share the chat LLM if avoidable).
#
# OpenRouter / OpenAI:
#   OPENFLOW_CATALOG_EMBED_BASE_URL="https://openrouter.ai/api/v1"
#   OPENFLOW_CATALOG_EMBED_API_KEY="sk-or-..."
#   OPENFLOW_CATALOG_EMBED_MODEL="openai/text-embedding-3-small"
#   OPENFLOW_CATALOG_EMBED_DIMS="1536"
#
# Hugging Face Text Embeddings Inference (TEI) on a remote GPU host:
#   OPENFLOW_CATALOG_EMBED_BASE_URL="http://gpu-host:8080/v1"
#   OPENFLOW_CATALOG_EMBED_NO_AUTH="true"
#   OPENFLOW_CATALOG_EMBED_MODEL="BAAI/bge-small-en-v1.5"
#   OPENFLOW_CATALOG_EMBED_DIMS="384"
#
# Ollama (remote or local):
#   OPENFLOW_CATALOG_EMBED_BASE_URL="http://ollama:11434/v1"
#   OPENFLOW_CATALOG_EMBED_NO_AUTH="true"
#   OPENFLOW_CATALOG_EMBED_MODEL="nomic-embed-text"
#   OPENFLOW_CATALOG_EMBED_DIMS="768"
#
# OPENFLOW_CATALOG_EMBED_BATCH="64"          # texts per request
# OPENFLOW_CATALOG_EMBED_CONCURRENCY="4"     # parallel batches
# OPENFLOW_CATALOG_EMBED_API_KEY=""
# OPENFLOW_CATALOG_EMBED_BASE_URL=""
# OPENFLOW_CATALOG_EMBED_MODEL="text-embedding-3-small"
# OPENFLOW_CATALOG_EMBED_DIMS="1536"
# Shared workspace for api Execute Command / Git clones + toolbox container:
# OPENFLOW_WORKSPACE_DIR="./data/workspace"
