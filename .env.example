# Database: PostgreSQL (run via `docker compose up -d db`)
DATABASE_URL="postgresql://openflow:openflow@localhost:15432/openflow"

# Disable auth for local development
AUTH_DISABLED="true"

# AES-256-GCM key for encrypting stored credentials (generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
CREDENTIALS_KEY="replace-with-64-char-hex-string-for-aes-256-gcm"

# Redis for BullMQ job queue
REDIS_URL="redis://localhost:6379"

# Directory for binary data storage
BINARY_STORAGE_DIR="./data/binary"

# BullMQ worker (runs inside the API process by default)
RUN_WORKER="true"
WORKER_CONCURRENCY="5"